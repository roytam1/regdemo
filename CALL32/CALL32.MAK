CFLAGS_D_WDLL = /nologo /G2 /W3 /Z7 /ALw /O2 /D "_DEBUG" /Fc /FR /GD 
CFLAGS_R_WDLL = /nologo /W3 /ALw /O2 /D "NDEBUG" /Fc /GD 
LFLAGS_D_WDLL = /NOLOGO /NOD /NOE /PACKC:61440 /ALIGN:16 /ONERROR:NOEXE /CO /MAP:FULL
LFLAGS_R_WDLL = /NOLOGO /NOD /NOE /PACKC:61440 /ALIGN:16 /ONERROR:NOEXE /MAP:FULL
LIBS_D_WDLL = oldnames libw oldnames libw ldllcew lnocrtdw vbapi 
LIBS_R_WDLL = oldnames libw ldllcew lnocrtdw vbapi 
RCFLAGS = /nologo
