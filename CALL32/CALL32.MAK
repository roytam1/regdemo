LFLAGS = $(LFLAGS_R_WDLL)
LIBS = $(LIBS_R_WDLL)
MAPFILE = nul
RCDEFINES = $(R_RCDEFINES)
!endif
!if [if exist MSVC.BND del MSVC.BND]
!endif
SBRS = CALL32.SBR


VBAPI_DEP = 

CALL32_RCDEP = 

all:	$(PROJ).DLL

CALL32.OBJ:	CALL32.C $(CALL32_DEP)
	$(CC) $(CFLAGS) $(CCREATEPCHFLAG) /c CALL32.C

CALL32.RES:	CALL32.RC $(CALL32_RCDEP)
	$(RC) $(RCFLAGS) $(RCDEFINES) -r CALL32.RC


$(PROJ).DLL::	CALL32.RES

$(PROJ).DLL::	CALL32.OBJ $(OBJS_EXT) $(DEFFILE)
